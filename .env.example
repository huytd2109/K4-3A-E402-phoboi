# Phoboi — Discord Logistics Assistant
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# ── Application Mode ──────────────────────────────────────────────
# "test" or "demo" = allows fixture data, shows demo banner
# "production" = only real sources, fixtures rejected
APP_ENV=demo

# ── Official Source Data ──────────────────────────────────────────
# Path to the official sources JSON file
OFFICIAL_SOURCES_PATH=data/official/sources.json
DISCORD_PACK_ENABLED=true
DISCORD_PACK_PATH=data/discord-pack/k4_messages.csv

# ── Discord Bot (only needed for Discord mode) ────────────────────
# DISCORD_BOT_TOKEN=       # Get from Discord Developer Portal
# DISCORD_GUILD_ID=        # Your server ID
# DISCORD_TA_ROLE_ID=      # Role ID for TAs who receive handoffs
# DISCORD_HANDOFF_CHANNEL_ID=  # Channel for TA escalations

# ── Authorized Source Channels (comma-separated Discord channel IDs)
# Only messages from these channels count as official sources
# AUTHORIZED_CHANNEL_IDS=

# ── Authorized Publisher Roles (comma-separated Discord role IDs)
# Only users with these roles can publish official sources
# AUTHORIZED_ROLE_IDS=

# ── LLM API Key (TÙY CHỌN — không bắt buộc cho MVP) ─────────────
# MVP sử dụng rule-based router, KHÔNG cần API key để chạy demo/test.
# Chỉ cần khi tích hợp LLM cho intent classification nâng cao.
#
# Hướng dẫn:
#   1. Tạo API key tại provider (ví dụ: https://console.anthropic.com)
#   2. Uncomment và điền key bên dưới
#   3. KHÔNG BAO GIỜ commit file .env lên git
#   4. KHÔNG BAO GIỜ gửi API key vào chat Discord
#
LLM_PROVIDER=rule_based        # rule_based | gemini
# GEMINI_API_KEY=              # Preferred Gemini key variable
# LLM_API_KEY=                 # Backward-compatible alternative
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=12

# ── Support Route ─────────────────────────────────────────────────
# Where to direct students for private support (shown in RESTRICT_PERSONAL responses)
SUPPORT_ROUTE=#hỗ-trợ-riêng

# ── Safety Limits ─────────────────────────────────────────────────
MAX_INPUT_LENGTH=2000
HANDOFF_COOLDOWN_SECONDS=300
